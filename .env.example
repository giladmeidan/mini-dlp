# Host port compose publishes the db on; if 5433 is taken, set it and the URLs below to match.
# DB_HOST_PORT=5433
# Host port compose publishes the app on; set it if 8000 is taken.
# APP_HOST_PORT=8000
DATABASE_URL=postgresql+psycopg://dlp:dlp@localhost:5433/mini_dlp
TEST_DATABASE_URL=postgresql+psycopg://dlp:dlp@localhost:5433/mini_dlp_test
MAX_SCAN_TEXT_CHARS=1000000
